PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
MILVUS_ADDRESS=127.0.0.1:19530
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=person_ai_chat
DB_SYNCHRONIZE=true
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

OSS_ACCESS_KEY=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
BUCKET_NAME=your-bucket-name
OSS_STS_ROLE_ARN=acs:ram::<account-id>:role/<role-name>
OSS_REGION=oss-cn-shanghai
OSS_UPLOAD_DIR=uploads/
OSS_POST_EXPIRE_SECONDS=600
OSS_STS_DURATION_SECONDS=3600
OSS_MAX_FILE_SIZE=104857600

ALI_YUN_AI_API_KEY=your-dashscope-api-key
ALI_YUN_AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALI_YUN_MODEL=qwen3-coder-flash
ALI_YUN_EMBEDDING_MODEL=text-embedding-v4
